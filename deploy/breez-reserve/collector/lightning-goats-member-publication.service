[Unit]
Description=Serve the frozen CyberHerd public reward signing projection
Requires=lightning-goats-member-publication.socket

[Service]
User=goats-project-collector
Group=goats-project-collector
StateDirectory=lightning-goats-project-collector
StateDirectoryMode=0700
UMask=0077
Environment=PYTHONPATH=/opt/lightning-goats-project-collector/modules
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/lightning-goats-project-collector/python/bin/python3.11 /opt/lightning-goats-project-collector/collector/member_publication.py
Restart=on-failure
RestartSec=3s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
