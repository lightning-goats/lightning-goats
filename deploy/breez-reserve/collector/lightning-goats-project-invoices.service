[Unit]
Description=Lightning Goats private Breez invoice issuer
Requires=lightning-goats-project-invoices.socket
After=network-online.target

[Service]
User=goats-project-collector
Group=goats-project-collector
StateDirectory=lightning-goats-project-collector
StateDirectoryMode=0700
UMask=0077
EnvironmentFile=/etc/lightning-goats-project-collector/config.env
LoadCredentialEncrypted=project-quote-token:/etc/credstore.encrypted/lightning-goats-reserve/mainnet-project-quote-token.cred
LoadCredential=home-ca.pem:/etc/nginx/goats-mint/home-ca.pem
LoadCredential=client.pem:/etc/nginx/goats-mint/project-receive-client.pem
LoadCredential=client.key:/etc/nginx/goats-mint/project-receive-client.key
Environment=PYTHONPATH=/opt/lightning-goats-project-collector/modules
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/lightning-goats-project-collector/python/bin/python3.11 /opt/lightning-goats-project-collector/collector/invoice_server.py --state-directory /var/lib/lightning-goats-project-collector --core-uid ${CORE_UID} --keyset ${MINT_KEYSET}
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=10.8.0.6/32
Restart=on-failure
RestartSec=3s
