LG_RESERVE_WALLET=REPLACE_WITH_STAGE_1_PUBLIC_IDENTITY
MINT_HOST=localhost
MINT_BACKEND_BOLT11_SAT=GoatsReserve
MINT_DATABASE=./db
CASHU_DIR=.
MINT_INFO_NAME="Lightning Goats Cashu Mint"
MINT_MAX_MINT_BOLT11_SAT=1000000
MINT_MAX_MELT_BOLT11_SAT=1000000
MINT_BOLT11_DISABLE_MELT=TRUE
MINT_MAX_BALANCE=0
MINT_INPUT_FEE_PPK=100
MINT_RATE_LIMIT=TRUE
MINT_RATE_LIMIT_PROXY_TRUST=FALSE
MINT_GLOBAL_RATE_LIMIT_PER_MINUTE=120
MINT_TRANSACTION_RATE_LIMIT_PER_MINUTE=30
MINT_RPC_SERVER_ENABLE=FALSE
MINT_REDIS_CACHE_ENABLED=FALSE
MINT_WATCHDOG_ENABLED=TRUE
MINT_WATCHDOG_IGNORE_MISMATCH=FALSE
DEBUG=FALSE
LOG_LEVEL=INFO
MINT_INFO_URLS='["https://mint.lightning-goats.com"]'
# Fee conversions are enabled only when the dedicated operator-fee-token credential is installed.
# Set the retained buffer after reconciling the live reserve and issuer expenses.
