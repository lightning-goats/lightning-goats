+
+// Lightning Goats reserve bridge. Both methods use the SDK-owned wallet.
+impl BreezSdk {
+    pub async fn goats_create_invoice(
+        &self,
+        amount_sat: u64,
+        memo: String,
+        description_hash: Option<[u8; 32]>,
+        expiry_secs: u32,
+    ) -> Result<(String, String), SdkError> {
+        use spark_wallet::{InvoiceDescription, InvoicePreimage};
+        let description = description_hash.map_or(
+            InvoiceDescription::Memo(memo),
+            InvoiceDescription::DescriptionHash,
+        );
+        let receive = self
+            .spark_wallet
+            .create_lightning_invoice(
+                amount_sat,
+                Some(description),
+                InvoicePreimage::FromSigner,
+                None,
+                Some(expiry_secs),
+                false,
+            )
+            .await?;
+        Ok((receive.invoice, receive.id))
+    }
+
+    pub async fn goats_receive_transfer(&self, ssp_id: &str) -> Result<Option<Payment>, SdkError> {
+        let payment = polling::poll_then_process_lightning_receive(self, ssp_id).await?;
+        if let Some(payment) = &payment {
+            polling::finalize_payment(self, payment.clone()).await;
+        }
+        Ok(payment)
+    }
+}
