# Non-secret Lightning Goats production configuration.
# Secrets are loaded through systemd credentials, not this file.

[service]
listen = "127.0.0.1:8787"
# Use shadow during production ingress verification. Change to active only after
# the zero-based cutover acceptance checks pass.
mode = "shadow"

[database]
url = "sqlite:///var/lib/lightning-goats/lightning-goats.db"

# Transitional CLN compatibility only; removed by Phase 1 issue #13.
[lightning]
clnrest_url = "https://127.0.0.1:3010"
clnrest_ca_certificate = "/etc/lightning-goats/clnrest-ca.pem"
herd_user = "herd"

# Phase 1 receive-only payment backend. The API key is loaded from the
# `strike-api-key` systemd credential and must have only:
#   partner.receive-request.create
#   partner.receive-request.read
# Webhook management should use a separate temporary/admin key when needed.
[strike]
api_url = "https://api.strike.me/"

[lnurl]
public_base_url = "https://lightning-goats.com/"
invoice_expiry_seconds = 300

# All Phase 1 Lightning Addresses are explicitly allowlisted and credit one
# common `herd` feeder pool. `address_user` remains durable payment metadata.
# The callback rejects non-whole-satoshi amounts before contacting Strike.
[[lightning_address]]
user = "herd"
display_name = "Lightning Goats"
description = "Feed the Lightning Goats"
credit_pool = "herd"
min_sendable_msat = 1000
max_sendable_msat = 1000000000

[[lightning_address]]
user = "dexter"
display_name = "Dexter"
description = "Feed Dexter and the Lightning Goats"
credit_pool = "herd"
min_sendable_msat = 1000
max_sendable_msat = 1000000000

[[lightning_address]]
user = "rowan"
display_name = "Rowan"
description = "Feed Rowan and the Lightning Goats"
credit_pool = "herd"
min_sendable_msat = 1000
max_sendable_msat = 1000000000

[[lightning_address]]
user = "cosmo"
display_name = "Cosmo"
description = "Feed Cosmo and the Lightning Goats"
credit_pool = "herd"
min_sendable_msat = 1000
max_sendable_msat = 1000000000

[[lightning_address]]
user = "newton"
display_name = "Newton"
description = "Feed Newton and the Lightning Goats"
credit_pool = "herd"
min_sendable_msat = 1000
max_sendable_msat = 1000000000

[[lightning_address]]
user = "nova"
display_name = "Nova"
description = "Feed Nova and the Lightning Goats"
credit_pool = "herd"
min_sendable_msat = 1000
max_sendable_msat = 1000000000

[feeder]
threshold_sats = 1000
inter_feed_delay_seconds = 30

# Transitional direct OpenHAB integration; replaced by the in-house gateway in
# Phase 1 issue #17. Do not use this direct path in the final architecture.
[openhab]
url = "http://127.0.0.1:8080"
feeder_rule_id = "REPLACE_WITH_PRODUCTION_FEEDER_RULE_ID"
override_item = "FeederOverride"
temperature_item = "AmbientWeatherWS2902A_WeatherDataWs2902a_Temperature"

[nostr]
nak_path = "/usr/local/bin/nak"
nak_config_path = "/run/lightning-goats/nak"
bunker_pubkey = "REPLACE_WITH_64_CHAR_HEX_PUBKEY"
relays = [
  "wss://relay.example",
]
