# Optional operator-only SERVER additions; preserve the deployed self-read route.
# Native NIP-98 verification and its root-pinned allowlist remain authoritative.
# Deployment must qualify WAF privacy/transport before exposing these routes.
location = /api/v1/cyberherd/operator/state {
    if ($request_method != GET) { return 405; }
    client_max_body_size 1k;
    limit_req zone=lightning_goats_read burst=5 nodelay;
    access_log off;
    proxy_pass http://127.0.0.1:3340;
    proxy_set_header Host $host;
    proxy_connect_timeout 1s;
    proxy_read_timeout 7s;
    add_header Cache-Control "no-store" always;
}
location = /api/v1/cyberherd/operator/templates {
    if ($request_method != GET) { return 405; }
    client_max_body_size 1k;
    limit_req zone=lightning_goats_read burst=5 nodelay;
    access_log off;
    proxy_pass http://127.0.0.1:3340;
    proxy_set_header Host $host;
    proxy_connect_timeout 1s;
    proxy_read_timeout 7s;
    add_header Cache-Control "no-store" always;
}
location = /api/v1/cyberherd/operator/command {
    if ($request_method != POST) { return 405; }
    client_max_body_size 16k;
    limit_req zone=lightning_goats_lnurl_invoice burst=3 nodelay;
    access_log off;
    proxy_pass http://127.0.0.1:3340;
    proxy_set_header Host $host;
    proxy_connect_timeout 1s;
    proxy_read_timeout 7s;
    add_header Cache-Control "no-store" always;
}
