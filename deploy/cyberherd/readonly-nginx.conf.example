# Optional SERVER-context snippet. Only install after the isolated view daemon
# and static feature flag are qualified. Never proxies mutation/admin endpoints.
location = /api/v1/cyberherd {
    limit_except GET { deny all; }
    limit_req zone=lightning_goats_read burst=10 nodelay;
    proxy_pass http://127.0.0.1:3340;
    proxy_set_header Host $host;
    proxy_connect_timeout 1s;
    proxy_read_timeout 3s;
    add_header Cache-Control "no-store" always;
}
location = /cyberherd { return 302 /cyberherd.html; }
location = /leaderboard { return 302 /cyberherd.html; }
