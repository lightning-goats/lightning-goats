# Optional SERVER-context signed self-status read. No operator proxy.
# The application verifies NIP-98 and rejects all GET bodies and queries.
location = /api/v1/cyberherd/me {
    if ($request_method != GET) { return 405; }
    client_max_body_size 1k;
    limit_req zone=lightning_goats_read burst=5 nodelay;
    proxy_pass http://127.0.0.1:3340;
    proxy_set_header Host $host;
    proxy_connect_timeout 1s;
    proxy_read_timeout 7s;
    add_header Cache-Control "no-store" always;
}
