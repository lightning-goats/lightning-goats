# HTTP context: install as /etc/nginx/sites-available/lightning-goats-canary.conf.
# Operator-approved staging hostname; provision reviewed TLS/static assets before enabling.
# Requires conf.d/lightning-goats-http.conf and snippets/lightning-goats-canary.conf.
server {
    listen 80;
    listen [::]:80;
    server_name feeder.lightning-goats.com;
    return 308 https://feeder.lightning-goats.com$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name feeder.lightning-goats.com;
    ssl_certificate /etc/letsencrypt/live/feeder.lightning-goats.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/feeder.lightning-goats.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;

    root /var/www/lightning-goats-canary;
    index index.html;
    include /etc/nginx/snippets/lightning-goats-canary.conf;

    location / {
        limit_except GET { deny all; }
        try_files $uri $uri/ =404;
    }
    location ~ /\. { deny all; }
}
