# SERVER context only. Install as /etc/nginx/snippets/lightning-goats-canary.conf.
# Also install lightning-goats-http.conf once in http{}; see deployment-artifacts.md.
# Use only an isolated staging hostname and harmless upstreams during acceptance.

# The application performs the actual six-user allowlist check.
location ~ "^/\.well-known/lnurlp/[a-z0-9._-]{1,64}$" {
    limit_except GET { deny all; }
    limit_req zone=lg_canary_lnurl_discovery burst=20 nodelay;
    proxy_pass http://lightning_goats_canary_backend;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    add_header Access-Control-Allow-Origin "*" always;
}

location ~ "^/lnurlp/[a-z0-9._-]{1,64}/callback$" {
    limit_except GET { deny all; }
    limit_req zone=lg_canary_lnurl_invoice burst=6 nodelay;
    proxy_pass http://lightning_goats_canary_backend;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    add_header Access-Control-Allow-Origin "*" always;
}

location = /api/v1/strike/webhook {
    limit_except POST { deny all; }
    if ($lightning_goats_json_content_type = 0) { return 415; }
    limit_req zone=lg_canary_webhook burst=30 nodelay;
    client_max_body_size 32k;
    proxy_pass http://lightning_goats_canary_backend/api/v1/strike/webhook;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}

# Isolated canary overlay websocket. Production /ws/overlay is unchanged until
# final cutover.
location = /ws/overlay {
    limit_except GET { deny all; }
    proxy_pass http://lightning_goats_canary_backend/ws/overlay;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $lightning_goats_connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 75s;
    proxy_send_timeout 75s;
}

location = /api/v1/status {
    limit_except GET { deny all; }
    limit_req zone=lg_canary_read burst=10 nodelay;
    proxy_pass http://lightning_goats_canary_backend/api/v1/status;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location = /healthz {
    allow 127.0.0.1;
    allow ::1;
    deny all;
    limit_except GET { deny all; }
    proxy_pass http://lightning_goats_canary_backend/healthz;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location ~ "^/(api|invoice|lnbits|cln|clnrest|clnaddress|lightning_goats|cyberherd|v1|rest|lnurlp|ws)(/|$)" {
    return 404;
}
location ~ "^/\.well-known/lnurlp(/|$)" { return 404; }
