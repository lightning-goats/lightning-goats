# Include inside the existing lightning-goats.com HTTPS server block.
# Existing production Lightning Addresses remain routed to LNbits until the
# zero-based cutover is explicitly executed.

upstream clnaddress_backend {
    server 127.0.0.1:9797;
    keepalive 8;
}

upstream lightning_goats_canary_backend {
    server 127.0.0.1:8788;
    keepalive 8;
}

# Canary Lightning Address only. proxy_pass without a URI preserves the
# original /.well-known/lnurlp/herd-canary request path expected by clnaddress.
location = /.well-known/lnurlp/herd-canary {
    proxy_pass http://clnaddress_backend;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    add_header Access-Control-Allow-Origin "*" always;
}

# clnaddress LNURL callback generated for canary invoices. Verify this path
# does not collide with the existing LNbits callback routing before reload.
location ^~ /invoice/ {
    proxy_pass http://clnaddress_backend;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    add_header Access-Control-Allow-Origin "*" always;
}

# Isolated canary overlay websocket. The production /ws/overlay route is not
# changed until final cutover.
location = /canary/ws/overlay {
    proxy_pass http://lightning_goats_canary_backend/ws/overlay;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 75s;
}

# Read-only canary operational status.
location = /canary/api/v1/status {
    proxy_pass http://lightning_goats_canary_backend/api/v1/status;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location = /canary/healthz {
    proxy_pass http://lightning_goats_canary_backend/healthz;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
}
