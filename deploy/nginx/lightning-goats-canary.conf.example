# Include inside the existing lightning-goats.com HTTPS server block.
# This is a canary configuration: existing production Lightning Addresses remain
# routed to LNbits until the cutover runbook explicitly changes them.

upstream clnaddress_backend {
    server 127.0.0.1:9797;
    keepalive 8;
}

upstream lightning_goats_backend {
    server 127.0.0.1:8787;
    keepalive 8;
}

# Canary Lightning Address only. proxy_pass without a URI preserves the
# original /.well-known/lnurlp/herd-canary request path expected by clnaddress.
location = /.well-known/lnurlp/herd-canary {
    proxy_pass http://clnaddress_backend;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    add_header Access-Control-Allow-Origin "*" always;
}

# clnaddress LNURL callback generated for the canary address.
location ^~ /invoice/ {
    proxy_pass http://clnaddress_backend;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    add_header Access-Control-Allow-Origin "*" always;
}

# Optional staging overlay websocket. Do not replace the current production
# overlay websocket until shadow/canary validation is complete.
location /ws/overlay-canary {
    proxy_pass http://lightning_goats_backend/ws/overlay;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 75s;
}

# Read-only canary status endpoint.
location = /api/v1/lightning-goats-canary/status {
    proxy_pass http://lightning_goats_backend/api/v1/status;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
}
