# Include inside the temporary staging HTTPS server block used to exercise the
# new VPS. Production lightning-goats.com remains on the existing stack until
# the operator-gated cutover.
#
# Define request zones once in nginx's http{} context, using distinct staging
# zone names if this file is loaded alongside production examples:
#   limit_req_zone $binary_remote_addr zone=lg_canary_lnurl_discovery:10m rate=60r/m;
#   limit_req_zone $binary_remote_addr zone=lg_canary_lnurl_invoice:10m rate=12r/m;
#   limit_req_zone $binary_remote_addr zone=lg_canary_webhook:10m rate=60r/m;

upstream lightning_goats_canary_backend {
    server 127.0.0.1:8788;
    keepalive 8;
}

# The application performs the actual six-user allowlist check.
location ~ ^/\.well-known/lnurlp/[a-z0-9._-]{1,64}$ {
    limit_req zone=lg_canary_lnurl_discovery burst=20 nodelay;
    proxy_pass http://lightning_goats_canary_backend;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    add_header Access-Control-Allow-Origin "*" always;
}

location ~ ^/lnurlp/[a-z0-9._-]{1,64}/callback$ {
    limit_req zone=lg_canary_lnurl_invoice burst=6 nodelay;
    proxy_pass http://lightning_goats_canary_backend;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    add_header Access-Control-Allow-Origin "*" always;
}

location = /api/v1/strike/webhook {
    limit_req zone=lg_canary_webhook burst=30 nodelay;
    client_max_body_size 32k;
    proxy_pass http://lightning_goats_canary_backend/api/v1/strike/webhook;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}

# Isolated canary overlay websocket. Production /ws/overlay is unchanged until
# final cutover.
location = /ws/overlay {
    proxy_pass http://lightning_goats_canary_backend/ws/overlay;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 75s;
}

location = /api/v1/status {
    proxy_pass http://lightning_goats_canary_backend/api/v1/status;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location = /healthz {
    proxy_pass http://lightning_goats_canary_backend/healthz;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
}
