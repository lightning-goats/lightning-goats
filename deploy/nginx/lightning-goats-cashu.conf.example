# Optional SERVER context. Requires matching reviewed core/wallet configuration.
# Include only after qualifying this exact edge and WAF; no public activation here.
# Reuses zones and JSON content-type map from lightning-goats-http.conf.example.
location = /api/v1/cashu {
    if ($request_method !~ ^(POST|OPTIONS)$) { return 405; }
    if ($args != "") { return 400; }
    # OPTIONS has no JSON body. The application validates POST content type.
    # Optional ModSecurity settings for this exact route.
    include cashu-token-waf.d/*.conf;
    limit_req zone=lightning_goats_lnurl_invoice burst=3 nodelay;
    limit_req_status 429;
    client_max_body_size 1m;
    client_body_buffer_size 1m;
    client_body_timeout 10s;
    proxy_request_buffering off;
    proxy_http_version 1.1;
    proxy_next_upstream off;
    proxy_connect_timeout 2s;
    proxy_send_timeout 10s;
    proxy_read_timeout 65s;
    proxy_cache off;
    proxy_no_cache 1;
    access_log off;
    error_log /dev/null crit;
    proxy_pass http://lightning_goats_backend/api/v1/cashu;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
}
location = /api/v1/cashu/request {
    if ($request_method !~ ^(GET|OPTIONS)$) { return 405; }
    if ($args != "") { return 400; }
    limit_req zone=lightning_goats_read burst=3 nodelay;
    limit_req_status 429;
    client_max_body_size 1k;
    client_body_buffer_size 1k;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_http_version 1.1;
    proxy_next_upstream off;
    proxy_connect_timeout 2s;
    proxy_read_timeout 3s;
    proxy_cache off;
    proxy_no_cache 1;
    access_log off;
    error_log /dev/null crit;
    proxy_pass http://lightning_goats_backend/api/v1/cashu/request;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
}
# Application-specific receipt status. Capability is JSON body-only, never URL.
location = /api/v1/cashu/status {
    if ($request_method !~ ^(POST|OPTIONS)$) { return 405; }
    if ($args != "") { return 400; }
    limit_req zone=lightning_goats_read burst=3 nodelay;
    limit_req_status 429;
    client_max_body_size 512;
    client_body_buffer_size 512;
    client_body_timeout 10s;
    proxy_request_buffering off;
    proxy_http_version 1.1;
    proxy_next_upstream off;
    proxy_connect_timeout 2s;
    proxy_read_timeout 3s;
    proxy_cache off;
    proxy_no_cache 1;
    access_log off;
    error_log /dev/null crit;
    proxy_pass http://lightning_goats_backend/api/v1/cashu/status;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
}
# Keep CORS/no-store decisions in the application, avoiding duplicate headers.
# Keep the enclosing API-prefix deny. Do not proxy arbitrary /api/v1/cashu/*.
# Any installed WAF must suppress request/response bodies, URL arguments and
# audit/debug capture on token ingress without disabling its request bounds or
# attack blocking. External CDN/WAF log acceptance is an explicit separate gate.

location = /api/v1/feeding/checkout {
    if ($request_method !~ ^POST$) { return 405; }
    if ($args != "") { return 400; }
    limit_req zone=lightning_goats_lnurl_invoice burst=3 nodelay;
    limit_req_status 429;
    client_max_body_size 512;
    client_body_buffer_size 512;
    client_body_timeout 10s;
    proxy_request_buffering off;
    proxy_http_version 1.1;
    proxy_next_upstream off;
    proxy_connect_timeout 2s;
    proxy_read_timeout 30s;
    proxy_cache off;
    proxy_no_cache 1;
    access_log off;
    error_log /dev/null crit;
    proxy_pass http://lightning_goats_backend/api/v1/feeding/checkout;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
}
