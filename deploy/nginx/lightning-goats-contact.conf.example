# Optional SERVER context, after the matching native schema/config upgrade.
# Exact POST routes only; no capability/email/message in URLs or access logs.
location = /api/v1/contact {
    limit_except POST { deny all; }
    if ($args != "") { return 400; }
    if ($lightning_goats_json_content_type = 0) { return 415; }
    limit_req zone=lightning_goats_lnurl_invoice burst=3 nodelay;
    client_max_body_size 32k;
    client_body_buffer_size 32k;
    proxy_request_buffering off;
    access_log off;
    proxy_pass http://lightning_goats_backend/api/v1/contact;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    add_header Cache-Control no-store always;
    add_header Referrer-Policy no-referrer always;
}
location = /api/v1/contact/status {
    limit_except POST { deny all; }
    if ($args != "") { return 400; }
    if ($lightning_goats_json_content_type = 0) { return 415; }
    limit_req zone=lightning_goats_read burst=3 nodelay;
    client_max_body_size 1k;
    client_body_buffer_size 1k;
    proxy_request_buffering off;
    access_log off;
    proxy_pass http://lightning_goats_backend/api/v1/contact/status;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    add_header Cache-Control no-store always;
    add_header Referrer-Policy no-referrer always;
}
# Preserve the existing WAF's audit/body-log suppression and all CRS blocking.
# Do not install an API-prefix proxy or disable WAF inspection for contact.
