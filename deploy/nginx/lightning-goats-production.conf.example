# SERVER context only. Install as /etc/nginx/snippets/lightning-goats-production.conf.
# Also install lightning-goats-http.conf once in http{}; see deployment-artifacts.md.
# Production remains on HOLD pending the Phase 1 audit acceptance gates.

# LUD-16 Lightning Address discovery. nginx deliberately forwards a generic
# username path; lightning-goatsd owns the explicit allowlist and rejects any
# user other than configured addresses before contacting Strike.
location ~ "^/\.well-known/lnurlp/[a-z0-9._-]{1,64}$" {
    limit_except GET { deny all; }
    limit_req zone=lightning_goats_lnurl_discovery burst=20 nodelay;
    proxy_pass http://lightning_goats_backend;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    add_header Access-Control-Allow-Origin "*" always;
}

# LUD-06 invoice callback. This is the endpoint which can create a Strike
# receive request, so it uses a substantially tighter edge rate limit.
location ~ "^/lnurlp/[a-z0-9._-]{1,64}/callback$" {
    limit_except GET { deny all; }
    limit_req zone=lightning_goats_lnurl_invoice burst=6 nodelay;
    proxy_pass http://lightning_goats_backend;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    add_header Access-Control-Allow-Origin "*" always;
}

# Strike completed-receive notification endpoint. Signature verification occurs
# in lightning-goatsd before event parsing, provider reads, or ledger changes.
location = /api/v1/strike/webhook {
    limit_except POST { deny all; }
    if ($lightning_goats_json_content_type = 0) { return 415; }
    limit_req zone=lightning_goats_strike_webhook burst=30 nodelay;
    client_max_body_size 32k;
    proxy_pass http://lightning_goats_backend/api/v1/strike/webhook;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}

# Read-only operational status used by the overlay.
location = /api/v1/status {
    limit_except GET { deny all; }
    limit_req zone=lightning_goats_read burst=10 nodelay;
    proxy_pass http://lightning_goats_backend/api/v1/status;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# Health is intentionally not a public endpoint. Local monitoring on the VPS
# can still use https://127.0.0.1/healthz with the appropriate Host header, or
# query lightning-goatsd directly on loopback.
location = /healthz {
    allow 127.0.0.1;
    allow ::1;
    deny all;
    limit_except GET { deny all; }
    proxy_pass http://lightning_goats_backend/healthz;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# Single server-to-client overlay websocket.
location = /ws/overlay {
    limit_except GET { deny all; }
    proxy_pass http://lightning_goats_backend/ws/overlay;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $lightning_goats_connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 75s;
    proxy_send_timeout 75s;
}

# Never proxy OpenHAB, the trusted integration gateway, local operator controls,
# or systemd credential material through nginx. The application listener remains
# loopback-only.

# Must follow the valid LNURL regexes. Exact public API locations take precedence.
# Reserved/retired paths never fall through to a static file or a generic proxy.
location ~ "^/(api|invoice|lnbits|cln|clnrest|clnaddress|lightning_goats|cyberherd|v1|rest|lnurlp|ws)(/|$)" {
    return 404;
}
location ~ "^/\.well-known/lnurlp(/|$)" { return 404; }
