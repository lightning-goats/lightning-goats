# Production Phase 1 routes for the lightning-goats.com HTTPS server.
# The static Lightning Goats page remains served by the surrounding server{}.
# Apply only after canary acceptance and while FeederOverride is ON.
#
# Define request zones once in nginx's http{} context:
#   limit_req_zone $binary_remote_addr zone=lightning_goats_lnurl_discovery:10m rate=60r/m;
#   limit_req_zone $binary_remote_addr zone=lightning_goats_lnurl_invoice:10m rate=12r/m;
#   limit_req_zone $binary_remote_addr zone=lightning_goats_read:10m rate=30r/m;
#   limit_req_zone $binary_remote_addr zone=lightning_goats_strike_webhook:10m rate=60r/m;

upstream lightning_goats_backend {
    server 127.0.0.1:8787;
    keepalive 8;
}

# LUD-16 Lightning Address discovery. nginx deliberately forwards a generic
# username path; lightning-goatsd owns the explicit allowlist and rejects any
# user other than configured addresses before contacting Strike.
location ~ ^/\.well-known/lnurlp/[a-z0-9._-]{1,64}$ {
    limit_req zone=lightning_goats_lnurl_discovery burst=20 nodelay;
    proxy_pass http://lightning_goats_backend;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    add_header Access-Control-Allow-Origin "*" always;
}

# LUD-06 invoice callback. This is the endpoint which can create a Strike
# receive request, so it uses a substantially tighter edge rate limit.
location ~ ^/lnurlp/[a-z0-9._-]{1,64}/callback$ {
    limit_req zone=lightning_goats_lnurl_invoice burst=6 nodelay;
    proxy_pass http://lightning_goats_backend;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    add_header Access-Control-Allow-Origin "*" always;
}

# Strike completed-receive notification endpoint. Signature verification occurs
# in lightning-goatsd before event parsing, provider reads, or ledger changes.
location = /api/v1/strike/webhook {
    limit_req zone=lightning_goats_strike_webhook burst=30 nodelay;
    client_max_body_size 32k;
    proxy_pass http://lightning_goats_backend/api/v1/strike/webhook;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}

# Read-only operational status used by the overlay.
location = /api/v1/status {
    limit_req zone=lightning_goats_read burst=10 nodelay;
    proxy_pass http://lightning_goats_backend/api/v1/status;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location = /healthz {
    # Prefer keeping health local-only unless an external monitor needs it.
    proxy_pass http://lightning_goats_backend/healthz;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# Single server-to-client overlay websocket.
location = /ws/overlay {
    proxy_pass http://lightning_goats_backend/ws/overlay;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 75s;
    proxy_send_timeout 75s;
}

# Never proxy CLNRest, OpenHAB, local operator controls, or systemd credential
# material through nginx. The application listener remains loopback-only.
