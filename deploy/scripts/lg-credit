#!/bin/sh
# Local operator convenience; run the ledger CLI as its existing runtime owner.
set -eu
if [ "${1:-}" = --help ]; then
    exec /usr/local/bin/lightning-goatsctl --config /etc/lightning-goats/config.receive.toml add-credit --help
fi
if [ "$(id -u)" -ne 0 ]; then
    echo 'Run with sudo lg-credit --id REFERENCE --sats AMOUNT --reason EXPLANATION [--dry-run]' >&2
    exit 1
fi
exec /usr/sbin/runuser -u lightning-goats -- /usr/local/bin/lightning-goatsctl \
    --config /etc/lightning-goats/config.receive.toml add-credit "$@"
