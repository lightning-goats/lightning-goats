[Unit]
Description=Purpose-limited CyberHerd outgoing NIP-46 signing broker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cyberherd-signer
Group=cyberherd-signer
SupplementaryGroups=cyberherd-payout-signer
ExecStart=/usr/local/bin/cyberherd-signerd --config /etc/cyberherd-signer/config.toml
LoadCredentialEncrypted=nostr-client-key:/etc/credstore.encrypted/cyberherd-signer-client
Restart=on-failure
RestartSec=5s
StateDirectory=cyberherd-signer
StateDirectoryMode=0700
RuntimeDirectory=cyberherd-signer
RuntimeDirectoryMode=0750
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/cyberherd-signer /run/cyberherd-signer
InaccessiblePaths=-/etc/lightning-goats -/var/lib/lightning-goats -/var/lib/cyberherd -/var/lib/cyberherd-payout
IPAddressDeny=10.0.0.0/8
IPAddressDeny=172.16.0.0/12
IPAddressDeny=192.168.0.0/16
IPAddressDeny=169.254.0.0/16
IPAddressDeny=fc00::/7
IPAddressDeny=fe80::/10
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
