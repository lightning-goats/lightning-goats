# Non-secret, temporary cutover configuration.
# Copy to /etc/lightning-goats/legacy-lnbits-migration.env and chmod 0644 or stricter.
# The LNbits invoice key is NOT stored here; it is a systemd credential.

LNBITS_URL=http://127.0.0.1:5000/

# Set this immediately after nginx stops creating new production Lightning
# Address invoices through LNbits. Use an integer Unix timestamp in seconds.
CUTOVER_AT=REPLACE_WITH_UNIX_TIMESTAMP

# Stable snapshot policy. Two identical rounds is the minimum accepted value.
STABLE_ROUNDS=2
SNAPSHOT_INTERVAL_SECONDS=2
SNAPSHOT_MAX_ROUNDS=30
