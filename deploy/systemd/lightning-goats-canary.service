[Unit]
Description=Lightning Goats Canary
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lightning-goats
Group=lightning-goats

ExecStart=/usr/local/bin/lightning-goatsd --config /etc/lightning-goats/config.canary.toml

StateDirectory=lightning-goats
StateDirectoryMode=0700
RuntimeDirectory=lightning-goats-canary
RuntimeDirectoryMode=0700
ConfigurationDirectory=lightning-goats
UMask=0077

Environment=RUST_LOG=info
# Canary Strike credentials must also be receive/read only. Prefer sandbox.
LoadCredentialEncrypted=strike-api-key:/etc/credstore.encrypted/lightning-goats-canary-strike-api-key
LoadCredentialEncrypted=strike-webhook-secret:/etc/credstore.encrypted/lightning-goats-canary-strike-webhook-secret
# Canary intentionally receives no NIP-46, OpenHAB, CLN, or LNbits credential.
# It reaches only the isolated trusted canary gateway for feeder simulation.

Restart=on-failure
RestartSec=5s

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
