[Unit]
Description=Lightning Goats Local Held Canary
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lightning-goats-held-canary
Group=lightning-goats-held-canary

ExecStart=/usr/local/bin/lightning-goats-held-canary --config /etc/lightning-goats-held-canary/config.toml

StateDirectory=lightning-goats-held-canary
StateDirectoryMode=0700
RuntimeDirectory=lightning-goats-held-canary
RuntimeDirectoryMode=0700
UMask=0077

Environment=RUST_LOG=info
LoadCredentialEncrypted=openhab-token:/etc/credstore.encrypted/lightning-goats-gateway-canary-openhab

Restart=on-failure
RestartSec=5s

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
