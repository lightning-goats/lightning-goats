[Unit]
Description=Lightning Goats Strike receives (physical dispatch disabled)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lightning-goats
Group=lightning-goats

ExecStart=/usr/local/bin/lightning-goatsd --config /etc/lightning-goats/config.receive.toml

StateDirectory=lightning-goats
StateDirectoryMode=0700
RuntimeDirectory=lightning-goats
RuntimeDirectoryMode=0700
ConfigurationDirectory=lightning-goats
UMask=0077

Environment=RUST_LOG=info
# Receive/read-only Strike runtime credentials.
LoadCredentialEncrypted=strike-api-key:/etc/credstore.encrypted/lightning-goats-strike-api-key
LoadCredentialEncrypted=strike-webhook-secret:/etc/credstore.encrypted/lightning-goats-strike-webhook-secret
# Receive-only deployment uses shadow mode: no new physical feeds or Nostr signing.
# No OpenHAB, CLN, or LNbits credential belongs on this host/service.

Restart=on-failure
RestartSec=5s

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
