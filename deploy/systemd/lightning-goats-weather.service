[Unit]
Description=Lightning Goats read-only local weather export
After=network.target

[Service]
Type=simple
User=lightning-goats-weather
Group=lightning-goats-weather
ExecStart=/usr/bin/python3 -B -E -s /usr/local/lib/lightning-goats-weather/serve_snapshot.py --database /var/lib/lightning-goats-weather/snapshot.db --port 5001
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
UMask=0077

[Install]
WantedBy=multi-user.target
