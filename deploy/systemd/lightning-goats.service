[Unit]
Description=Lightning Goats
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lightning-goats
Group=lightning-goats

ExecStart=/usr/local/bin/lightning-goatsd --config /etc/lightning-goats/config.toml

StateDirectory=lightning-goats
StateDirectoryMode=0700
RuntimeDirectory=lightning-goats
RuntimeDirectoryMode=0700
ConfigurationDirectory=lightning-goats
UMask=0077

Environment=RUST_LOG=info
# Phase 1 Strike runtime credentials. The API key must be receive/read only.
LoadCredentialEncrypted=strike-api-key:/etc/credstore.encrypted/lightning-goats-strike-api-key
LoadCredentialEncrypted=strike-webhook-secret:/etc/credstore.encrypted/lightning-goats-strike-webhook-secret
# Transitional credentials removed by Phase 1 issues #13 and #17.
LoadCredentialEncrypted=cln-rune:/etc/credstore.encrypted/lightning-goats-cln-rune
LoadCredentialEncrypted=openhab-token:/etc/credstore.encrypted/lightning-goats-openhab
LoadCredentialEncrypted=nostr-client-key:/etc/credstore.encrypted/lightning-goats-nostr-client

Restart=on-failure
RestartSec=5s

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
